{
  "version": "1.0",
  "parameters": {
    "lesson_duration_minutes": 120,
    "practice_quota": { "easy": 15, "medium": 10, "hard": 5 },
    "practice_quota_is_per_unit": true,
    "units_per_lesson": 1,
    "compute_session_totals_formula": "session_total[d] = units_per_lesson * practice_quota[d]",
    "difficulty_scale": { "easy": 1, "medium": 2, "hard": 3 },
    "correct_field": "accuracy",
    "difficulty_field": "difficulty",
    "domain_field": "domain",
    "section_field": "section",
    "skill_field": "skill",
    "id_field": "id",
    "mastery_threshold_overall": 0.8,
    "exit_ticket_count": { "easy": 2, "medium": 2, "hard": 1 },
    "max_lessons": 10,
    "min_questions_per_domain_for_selection": 5,
    "recompute_priority_after_each_lesson": true,
    "priority_formula": "(1 - accuracy) * (1 + 0.5 * ln(total + 1))",
    "selection_policy": [
      "prefer_incorrect",
      "then_unseen",
      "then_lowest_skill_coverage",
      "then_random"
    ],
    "avoid_repeat_window_lessons": 3
  },
  "data_sources": {
    "questions_csv": "questions.csv",
    "lectures_json": "lectures.json"
  },
  "lecture_mapping": {
    "strategy": "keyword_search",
    "domain_keywords": {
      "Algebra": ["linear", "inequalit", "function", "system"],
      "Advanced Math": ["quadratic", "nonlinear", "radical", "equivalent expression"],
      "Geometry and Trigonometry": ["triangle", "circle", "angle", "area", "volume", "trig"],
      "Problem-Solving and Data Analysis": ["rate", "ratio", "percent", "data", "scatterplot", "probability", "inference"],
      "Expression of Ideas": ["transition", "organization", "coherence", "synthesis"],
      "Information and Ideas": ["central idea", "evidence", "inference", "detail"],
      "Craft and Structure": ["structure", "purpose", "words in context", "cross-text"],
      "Standard English Conventions": ["grammar", "punctuation", "boundaries", "agreement"]
    },
    "max_lectures_per_lesson": 3
  },
  "lesson_structure": [
    { "name": "Warm-up diagnostics", "minutes": 20, "items": 5 },
    { "name": "Concept teaching", "minutes": 35, "lectures": "<=3" },
    { "name": "Guided examples", "minutes": 15 },
    { "name": "Independent practice", "minutes": 45, "practice_quota_ref": "parameters.practice_quota" },
    { "name": "Error log & exit ticket", "minutes": 5, "exit_ticket_ref": "parameters.exit_ticket_count" }
  ],
  "outputs": {
    "plan_json": {
      "schema": {
        "lesson_id": "string",
        "section": "string",
        "domain": "string",
        "target_metrics": {
          "baseline_accuracy": "float",
          "post_accuracy": "float|null"
        },
        "lectures": [ { "title": "string", "unit": "string|number" } ],
        "practice": {
          "easy": ["question_id"],
          "medium": ["question_id"],
          "hard": ["question_id"]
        },
        "exit_ticket": ["question_id"],
        "notes": "string"
      }
    }
  }
}


